# KiCad runs as a separate GUI application. Start KiCad 9+ and open the project first.
# kicad-python reads these official variables when KiCad provides them.
# When the server is launched from an MCP host instead of KiCad, kicad-python
# falls back to the platform default endpoint (macOS: ipc:///tmp/kicad/api.sock,
# created by KiCad in its temp directory at launch; set KICAD_API_SOCKET to
# target a specific instance when several KiCad instances are running).
# KICAD_API_SOCKET=
# KICAD_API_TOKEN=

KIPILOT_KICAD_CLIENT_NAME=kipilot-mcp
KIPILOT_KICAD_TIMEOUT_MS=60000
KIPILOT_LOG_LEVEL=INFO
# KIPILOT_LOG_FILE=.logs/kipilot-mcp.log
